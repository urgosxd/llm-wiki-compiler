{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@atomicstrata/llmwiki-core/compiler-cli": [
        "./src/compiler-cli.ts"
      ],
      "@atomicstrata/llmwiki-core/compiler-sdk": [
        "./src/sdk/compiler-composition.ts"
      ],
      "@atomicstrata/llmwiki-core": [
        "./src/core-index.ts"
      ],
      "llm-wiki-compiler": [
        "./src/index.ts"
      ],
      "llmwiki-kg": [
        "./packages/llmwiki-kg/ts/src/core-index.ts"
      ],
      "llmwiki-kg/server": [
        "./packages/llmwiki-kg/ts/src/server.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}