{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@atomicstrata/llmwiki-core/compiler-sdk": [
        "./packages/wiki/src/sdk/compiler-composition.ts"
      ],
      "@atomicstrata/llmwiki-core": [
        "./packages/wiki/src/core-index.ts"
      ],
      "llm-wiki-compiler": [
        "./packages/wiki/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/wiki/src/**/*",
    "packages/api/src/**/*.ts",
    "packages/foundation/src/**/*.ts",
    "packages/llmwiki-core/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}