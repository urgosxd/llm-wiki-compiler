# Copy to `.env` at the repository root and fill in; `docker compose` reads that.
#
# The product runs against an OpenAI-COMPATIBLE endpoint, not necessarily
# api.openai.com. Any server that speaks the OpenAI wire format works: LiteLLM,
# vLLM, Ollama's OpenAI shim, LM Studio, a gateway, or the real API.

# ---- required -----------------------------------------------------------------

# The Stack both dimensions write to. Create one first:
#   docker compose exec db psql -U llmwiki -d llmwiki \
#     -c "insert into stacks (id, name, domain) values (gen_random_uuid(), 'mine', 'mine')"
AKS_STACK_ID=

# Your endpoint's base URL, INCLUDING the version segment. Examples:
#   http://127.0.0.1:11434/v1     (Ollama)
#   http://127.0.0.1:4000/v1      (LiteLLM)
#   https://api.openai.com/v1     (the real thing)
OPENAI_BASE_URL=

# Your endpoint's key. Any non-empty value for a server that ignores auth.
PROVIDER_API_KEY=

# ---- models -------------------------------------------------------------------
# These must exist on your endpoint. The embedding model's output size MUST equal
# EMBEDDING_DIM, because `db/schema.sql` declares `vector(768)`. A mismatch is not
# rejected by the schema and produces vectors the store cannot compare.

LLMWIKI_MODEL=gpt-4o-mini
LLMWIKI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=768

# ---- optional -----------------------------------------------------------------

# Override the embedding endpoint when it lives somewhere other than
# OPENAI_BASE_URL. Defaults to OPENAI_BASE_URL.
# OPENAI_EMBEDDINGS_BASE_URL=

# The graph routes' own key. Empty means open access, which is the documented
# default; set it to require `X-API-Key`.
AKS_API_KEY=

# Where the wiki lives on the host. Defaults to this directory.
# LLMWIKI_PROJECT=/absolute/path/to/your/wiki

# The listener's bind address. Loopback is the intended surface for a local wiki;
# a LAN address exposes it deliberately and requires nothing else.
LLMWIKI_HOST=127.0.0.1

# ---- not needed unless you diverge from the defaults -------------------------
# The compose already maps these from the variables above; they are listed so the
# two halves of the product can be pointed at DIFFERENT providers if you ever want
# that. The root side reads LLMWIKI_PROVIDER; the KG side reads the two *_PROVIDER
# names. Setting only one half leaves the other calling its own default vendor.
# LLMWIKI_PROVIDER=openai
# EMBEDDING_PROVIDER=gateway
# EXTRACTION_PROVIDER=gateway
