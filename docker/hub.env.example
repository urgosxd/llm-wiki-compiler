# Variables para `docker-compose.hub.yml` — copiar a `.env` junto al compose.
#
# Este archivo es para DESPLIEGUE desde la imagen publicada, no para desarrollo.
# El `.env` de desarrollo en la raíz del repo lo usa `docker-compose.yml`, que
# compila desde fuente y por eso además necesita el código.
#
#   cp docker/hub.env.example .env    # y completar los tres obligatorios

# ---- obligatorios -------------------------------------------------------------

# El Stack al que escriben ambas dimensiones. Crear uno primero:
#   docker compose -f docker-compose.hub.yml exec db \
#     psql -U llmwiki -d llmwiki -tAc \
#     "insert into stacks (id,name,domain) values (gen_random_uuid(),'mine','mine') returning id"
AKS_STACK_ID=

# Tu endpoint compatible con OpenAI, INCLUYENDO el segmento de versión.
#   http://127.0.0.1:11434/v1     (Ollama)
#   http://127.0.0.1:4000/v1      (LiteLLM)
#   https://api.openai.com/v1     (el de verdad)
OPENAI_BASE_URL=

# La key del endpoint. Cualquier valor no vacío si el servidor ignora auth.
OPENAI_API_KEY=

# ---- imagen y puertos ---------------------------------------------------------

LLMWIKI_IMAGE=urgosxd7/llmwiki:latest

# El listener HTTP. Con host networking el `ports:` no aplica; el proceso bindea
# esta dirección directamente en el host.
LLMWIKI_PORT=4173
# Loopback es lo correcto si vas a poner un reverse proxy adelante. NO uses
# 0.0.0.0: el gate de origen rechaza el wildcard y todo responde 403.
LLMWIKI_HOST=127.0.0.1

# Postgres se publica acá porque la app corre con host networking y no puede
# resolver `db` por DNS. Si 5435 está ocupado, cambiar.
POSTGRES_HOST_PORT=5435

# ---- base de datos ------------------------------------------------------------
# Cambiar POSTGRES_PASSWORD en un servidor expuesto. Los tres se leen tanto en la
# creación del contenedor como en los DSN de la app.

POSTGRES_USER=llmwiki
POSTGRES_PASSWORD=llmwiki
POSTGRES_DB=llmwiki

# ---- wiki ---------------------------------------------------------------------

# Dónde vive el wiki en el host. Se monta en /work dentro del contenedor.
LLMWIKI_PROJECT=./wiki

# ---- modelos ------------------------------------------------------------------
# Deben existir en tu endpoint. La dimensión de salida del modelo de embeddings
# TIENE que ser igual a EMBEDDING_DIM, porque el schema declara vector(768).
# Una diferencia no la rechaza el schema: guarda vectores incomparables.

LLMWIKI_MODEL=gpt-4o-mini
LLMWIKI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=768

# ---- opcionales ---------------------------------------------------------------

# Key propia de las rutas del grafo. Vacío = acceso abierto, que es el default
# documentado. Con valor, exige `X-API-Key`.
AKS_API_KEY=

# Nombre visible del Stack.
AKS_STACK_NAME=llmwiki
