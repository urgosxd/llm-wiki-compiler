{
  "_validator": "@local/orchestration (global package at ~/.agents/orchestration; contract stays per-repo)",
  "_ratified": "human-ratified: two-dimension split (A=wiki, B/C=KG), product surface frozen for every role",
  "version": 1,
  "sharedPaths": [
    ".fallowrc.json",
    ".github/**",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "README.md",
    "SOURCES_CONTRACT.md",
    "docs/**",
    "eslint.config.js",
    "examples/**",
    "package-lock.json",
    "packages/llmwiki-core/**",
    "packages/llmwiki-dev-backend/**",
    "packages/llmwiki-limited-isolation-backend/**",
    "packages/llmwiki-local-workflows/**",
    "scripts/**",
    "src/artifacts/**",
    "src/capability-providers/**",
    "src/citations/**",
    "src/cli.ts",
    "src/cli/**",
    "src/commands/**",
    "src/compiler/**",
    "src/connectors/**",
    "src/context/**",
    "src/core-index.ts",
    "src/dimensions/activation.ts",
    "src/dimensions/coordinator.ts",
    "src/dimensions/index.ts",
    "src/dimensions/outbox.ts",
    "src/dimensions/reconcile.ts",
    "src/dimensions/types.ts",
    "src/eval/**",
    "src/export/**",
    "src/freshness/**",
    "src/import/**",
    "src/index.ts",
    "src/ingest/**",
    "src/limited-isolation/**",
    "src/linter/**",
    "src/local-workflow-host/**",
    "src/mcp/**",
    "src/operation-bundles/**",
    "src/operations-packs/**",
    "src/pages/**",
    "src/preparations/**",
    "src/products/**",
    "src/profile/**",
    "src/project/**",
    "src/prompt-templates.ts",
    "src/relations/**",
    "src/sdk/**",
    "src/search/**",
    "src/sources/**",
    "src/status/**",
    "src/trust/**",
    "src/utils/**",
    "src/viewer/**",
    "src/wiki/**",
    "src/workflows/**",
    "test-typecheck-baseline.json",
    "tsup.config.ts"
  ],
  "roles": {
    "orchestrator-a": {
      "module": "wiki-dimension-and-integration",
      "worktree": ".worktrees/orchestrator-a",
      "ownedPaths": [
        "src/dimensions/wiki/**",
        "contract-cordination.json",
        "package.json",
        "tsconfig*.json",
        "vitest.config.ts",
        "odd/**",
        "test/dimensions/wiki-*",
        "test/dimensions/cross-dimension-rollback.test.ts"
      ],
      "forbiddenPaths": [
        "src/dimensions/kg/**",
        "packages/llmwiki-kg/**",
        "test/dimensions/kg-*/**",
        "test/compiler-*/**",
        "test/context-*/**",
        "test/cli-*/**",
        "test/commands-*/**",
        ".worktrees/**"
      ]
    },
    "orchestrator-b": {
      "module": "kg-core-dimension",
      "worktree": ".worktrees/orchestrator-b",
      "ownedPaths": [
        "src/dimensions/kg/**",
        "packages/llmwiki-kg/ts/src/core/**",
        "packages/llmwiki-kg/ts/src/pydantic/**",
        "packages/llmwiki-kg/ts/oracle/**",
        "packages/llmwiki-kg/odd/**",
        "test/dimensions/kg-dimension.test.ts",
        "test/dimensions/kg-core-*"
      ],
      "forbiddenPaths": [
        "src/dimensions/wiki/**",
        "test/dimensions/wiki-*/**",
        "packages/llmwiki-kg/ts/src/routes/**",
        "packages/llmwiki-kg/ts/src/mcp/**",
        "packages/llmwiki-kg/ts/src/*.ts",
        "contract-cordination.json",
        "package.json",
        "tsconfig*.json",
        "vitest.config.ts",
        "odd/**",
        ".worktrees/**"
      ]
    },
    "orchestrator-c": {
      "module": "kg-runtime-dimension",
      "worktree": ".worktrees/orchestrator-c",
      "ownedPaths": [
        "packages/llmwiki-kg/ts/src/routes/**",
        "packages/llmwiki-kg/ts/src/mcp/**",
        "packages/llmwiki-kg/ts/src/*.ts",
        "test/dimensions/kg-runtime-*"
      ],
      "forbiddenPaths": [
        "src/dimensions/wiki/**",
        "src/dimensions/kg/**",
        "test/dimensions/wiki-*/**",
        "test/dimensions/kg-*/**",
        "packages/llmwiki-kg/ts/src/core/**",
        "packages/llmwiki-kg/ts/src/pydantic/**",
        "packages/llmwiki-kg/ts/oracle/**",
        "packages/llmwiki-kg/odd/**",
        "contract-cordination.json",
        "package.json",
        "tsconfig*.json",
        "vitest.config.ts",
        "odd/**",
        ".worktrees/**"
      ]
    }
  }
}