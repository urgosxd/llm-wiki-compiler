# ----------------------------------------------------------------
# Database
# ----------------------------------------------------------------
DATABASE_URL=postgresql://aks:aks@db:5432/aks

# ----------------------------------------------------------------
# Optional API key for protecting this server. Leave blank in dev.
# ----------------------------------------------------------------
AKS_API_KEY=

# ----------------------------------------------------------------
# LLM provider configuration
# ----------------------------------------------------------------
# Pick where embedding and extraction traffic should go.
#
#   EMBEDDING_PROVIDER:
#     openai    - direct to api.openai.com (needs OPENAI_API_KEY)
#     gateway   - OpenAI-compatible gateway (needs GATEWAY_URL + GATEWAY_API_KEY)
#
#   EXTRACTION_PROVIDER:
#     anthropic - direct to api.anthropic.com (needs ANTHROPIC_API_KEY)
#     openai    - direct to api.openai.com (needs OPENAI_API_KEY)
#     gateway   - OpenAI-compatible gateway (needs GATEWAY_URL + GATEWAY_API_KEY)
#
# Default: direct to OpenAI for embeddings, direct to Anthropic for extraction.
EMBEDDING_PROVIDER=openai
EXTRACTION_PROVIDER=anthropic

# Models. The provider must support the model you choose.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EXTRACTION_MODEL=claude-sonnet-4-5

# ----------------------------------------------------------------
# Provider credentials. Only set the ones your chosen providers need.
# ----------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------
# Gateway settings (only when a provider is set to "gateway")
# Useful for routing traffic through a centralized provider with
# budget tracking and observability. The gateway must present an
# OpenAI-compatible API.
# ----------------------------------------------------------------
GATEWAY_URL=
GATEWAY_API_KEY=