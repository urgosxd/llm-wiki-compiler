# Synthetic (OpenAI-compatible) embeddings — nomic-embed-text-v1.5 is 768-dim,
# which matches wiki.page_embeddings.vector(768) exactly. No migration needed.
LLMWIKI_EMBEDDING_PROVIDER=openai
LLMWIKI_EMBEDDING_MODEL=hf:nomic-ai/nomic-embed-text-v1.5
OPENAI_EMBEDDINGS_BASE_URL=https://api.synthetic.new/openai/v1
# Dedicated embeddings key. Without it the client falls back to OPENAI_API_KEY and
# llmwiki warns that a cloud key is being forwarded to another operator.
OPENAI_EMBEDDINGS_API_KEY=sk-...
