            "pages": [
              "troubleshooting/faq",
              "troubleshooting/stale-pages"
            ]
          }
        ]
      }
    ]
  },
  "keyFeatures": [
    "Two-phase LLM compile pipeline: concept extraction then page generation",
    "Incremental compilation with content-hash change detection",
    "Hybrid semantic + BM25 retrieval with wikilink-graph expansion",
    "Paragraph- and claim-level citation tracing back to source line ranges",
    "Local read-only web viewer with search, graph, and provenance chips",
    "MCP server for Claude Desktop, Cursor, and Claude Code integration",
    "In-process SDK via createWiki() for embedding llmwiki programmatically",
    "Source freshness tracking with stale/orphaned page detection",
    "Eval harness with CI-gateable health scores and citation quality metrics",
    "Multi-provider support: Anthropic, OpenAI-compatible, Ollama, GitHub Copilot, Claude Agent SDK",
    "Export to llms.txt, JSON, JSON-LD, GraphML, and Marp slides",
    "Obsidian-compatible wikilinks with alias resolution",
    "Activity journal (log.md) for audit tracing",
    "Rule-candidate extraction from ingested sources"
  ],
  "publicApiSurface": [
    "createWiki({ root })",
    "wiki.ingest({ source })",
    "wiki.ingestText({ title, text })",
    "wiki.compile(options?)",
    "wiki.query(question, options?)",
    "wiki.getPage(ref)",
    "wiki.listPages(options?)",
    "wiki.listSources(options?)",
    "wiki.getSource(id)",
    "wiki.status()",
    "wiki.lint()",
    "wiki.getContextPack({ prompt, budget?, depth?, topPages?, topChunks? })",
    "wiki.exportJson(options?)",
    "wiki.runEval({ mode, record? })",
    "MCP tool: ingest_source",
    "MCP tool: compile_wiki",
    "MCP tool: query_wiki",
    "MCP tool: search_pages",
    "MCP tool: read_page",
    "MCP tool: lint_wiki",
    "MCP tool: wiki_status",
    "MCP tool: get_context_pack",
    "MCP tool: run_eval",
    "MCP resource: llmwiki://index",
    "MCP resource: llmwiki://concept/{slug}",
    "MCP resource: llmwiki://query/{slug}",
    "MCP resource: llmwiki://sources",
    "MCP resource: llmwiki://state",
    "MCP resource: llmwiki://eval/report",
    "MCP resource: llmwiki://eval/history"
  ]
}
