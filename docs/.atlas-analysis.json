{
  "projectType": "cli-tool",
  "projectName": "llmwiki",
  "projectDescription": "A knowledge compiler that turns raw sources — URLs, files, and session exports — into a persistent, interlinked markdown wiki with semantic search, citation tracing, and MCP agent integration.",
  "theme": "luma",
  "primaryColor": "#5B6AD0",
  "lightColor": "#EEF0FF",
  "darkColor": "#1A1D3A",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "installation"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/how-it-works",
              "concepts/wiki-model",
              "concepts/page-types",
              "concepts/citations"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/providers",
              "configuration/environment-variables",
              "configuration/schema"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/mcp-agent-integration",
              "guides/sdk",
              "guides/atomic-memory-bridge"
            ]
          },
          {
