{
  "$schema": "https://mintlify.com/docs.json",
  "name": "llmwiki",
  "description": "llmwiki compiles raw sources into persistent, citation-traceable markdown wikis that agents and humans can browse, query, lint, export, import, and reuse.",
  "theme": "luma",
  "colors": {
    "primary": "#5B6AD0",
    "light": "#EEF0FF",
    "dark": "#1A1D3A"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/atomicstrata/llm-wiki-compiler"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "installation",
              "guides/open-knowledge-format"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/karpathy-pattern",
              "concepts/how-it-works",
              "concepts/wiki-model",
              "concepts/configurable-lifecycle-profiles",
              "concepts/page-types",
              "concepts/citations",
              "concepts/tenant-isolation",
              "concepts/kg-open-classification"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/providers",
              "configuration/environment-variables",
              "configuration/stack-ontology",
              "configuration/kg-type-catalog",
              "configuration/kg-classification",
              "configuration/review-policy",
              "configuration/schema",
              {
                "group": "Configurable Lifecycle Profiles",
                "expanded": false,
                "pages": [
                  "configuration/profiles",
                  "configuration/autosci-profile",
                  "configuration/profile-templates"
                ]
              }
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/mcp-agent-integration",
              "guides/http-ingest-jobs",
              "guides/viewer-themes",
              "guides/sdk",
              "guides/sdk-packages",
              "guides/sdk-upgrade",
              "guides/atomic-memory-bridge",
              "guides/row-backed-wiring-reachability",
              "guides/wiki-db-parity-migration",
              "guides/kg-classification-migration",
              {
                "group": "Configurable Lifecycle Profiles",
                "expanded": false,
                "pages": [
                  "guides/clp/build-your-first-profile",
                  "guides/autosci-research-workflow",
                  "guides/newsroom-editorial-workflow",
                  "guides/publish-template-tap"
                ]
              }
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/faq",
              "troubleshooting/stale-pages"
            ]
          }
        ]
      }
    ]
  }
}
