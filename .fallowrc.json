{
  "$schema": "https://fallow.tools/schema.json",
  "entry": [
    "scripts/check-fallow-report.mjs",
    "packages/wiki/src/core-index.ts",
    "packages/wiki/src/index.ts",
    "packages/wiki/src/sdk/compiler-composition.ts",
    "packages/wiki/src/viewer/assets/viewer.js",
    "scripts/copy-viewer-assets.mjs",
    "scripts/measure-graph-expansion.ts",
    "packages/wiki/src/viewer/assets/viewer-theme-boot.js",
    "test/fixtures/mock-embeddings.mjs",
    "test/fixtures/track-dotenv-read.mjs",
    "test/fixtures/sigterm-at-ready.cjs",
    "test/fixtures/documents/make-fixtures.mjs",
    "test/fixtures/install-preflight-child.mjs",
    "test/fixtures/deny-uninstalled-packages.mjs",
    "packages/wiki/src/dimensions/index.ts",
    "packages/api/src/main.ts"
  ],
  "ignorePatterns": [
    "docs/**",
    "packages/wiki/src/viewer/assets/index.html",
    "packages/wiki/src/viewer/assets/viewer-content.css",
    "packages/wiki/src/viewer/assets/viewer-tokens.css",
    "packages/wiki/src/viewer/assets/viewer-chrome.css",
    "packages/wiki/src/viewer/assets/viewer-dashboard.css",
    "packages/wiki/src/viewer/assets/viewer-health.css",
    "packages/wiki/src/viewer/assets/viewer-pipeline.css",
    "packages/wiki/src/viewer/assets/viewer-graph.css",
    "packages/wiki/src/viewer/assets/viewer-material.css",
    "packages/llmwiki-kg/**"
  ],
  "ignoreDependencies": [
    "dotenv",
    "@fontsource/dm-sans",
    "@fontsource/nunito",
    "@fontsource/space-grotesk",
    "@fontsource/jetbrains-mono",
    "@repo/kg",
    "@repo/wiki",
    "postgres",
    "picomatch",
    "@hono/node-server",
    "ajv",
    "express"
  ],
  "ignoreExports": [
    {
      "file": "packages/wiki/src/utils/output.ts",
      "exports": [
        "getQuiet"
      ]
    }
  ],
  "overrides": [
    {
      "files": [
        "packages/wiki/src/providers/*.ts",
        "packages/wiki/src/utils/provider-guard.ts"
      ],
      "rules": {
        "unused-class-members": "off"
      }
    }
  ]
}
