{
  "name": "@repo/kg",
  "version": "0.2.0",
  "private": true,
  "description": "TypeScript port of the AKS Reference Server (Express 5 + Zod + Drizzle + Vitest)",
  "type": "module",
  "exports": {
    ".": "./src/core-index.ts",
    "./core-index": "./src/core-index.ts",
    "./server": "./src/server.ts",
    "./config": "./src/config.ts",
    "./db": "./src/db.ts",
    "./mcp": "./src/mcp.ts",
    "./mcp-harness": "./src/mcp-harness.ts",
    "./embedding-backend": "./src/embedding-backend.ts",
    "./chat-backend": "./src/chat-backend.ts",
    "./wiki-credential-fallback": "./src/wiki-credential-fallback.ts",
    "./core/ontology": "./src/core/ontology.ts",
    "./core/extraction-harness": "./src/core/extraction-harness.ts",
    "./core/llm/endpoints": "./src/core/llm/endpoints.ts",
    "./core/llm/embeddings": "./src/core/llm/embeddings.ts",
    "./core/llm/tool-call": "./src/core/llm/tool-call.ts",
    "./testing/per-run-database": "./src/testing/per-run-database.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "node ../../../scripts/package-tasks.ts test --package @repo/kg",
    "test:watch": "vitest",
    "lint": "node ../../../scripts/package-tasks.ts lint --package @repo/kg",
    "typecheck": "node ../../../scripts/package-tasks.ts typecheck --package @repo/kg",
    "fallow": "node ../../../scripts/package-tasks.ts fallow --package @repo/kg",
    "eval:kg": "tsx src/core/eval/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@repo/foundation": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
